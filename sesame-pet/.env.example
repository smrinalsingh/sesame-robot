# Copy to .env (git-ignored) and fill in.
# AI gateway (CLIProxyAPI on bolthub-server) - key is CLIENT_KEY from ~/.config/cli-proxy-api/keys.env
OPENAI_BASE_URL=http://10.10.10.108:8317/v1
OPENAI_API_KEY=
REALTIME_MODEL=gpt-realtime
# "sim" for the simulator, or the robot's address, e.g. http://192.168.1.50
ROBOT_URL=sim
# Your clone of sesame-robot (pet branch): firmware + STLs are read from here
SESAME_ROBOT_DIR=../sesame-robot
